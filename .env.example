# Copy this file to .env and adjust the values for your machine.
# The application reads environment variables at startup (python-dotenv).

# Used by `flask run` if you start the app that way.
FLASK_APP=run.py
FLASK_DEBUG=0

# Development default only. Generate a real value before exposing the API:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# SQLite is the default and the only supported database.
# Relative paths are resolved from the project root, not the shell's cwd.
#   sqlite:///data/document_converter.db      -> <project>/data/document_converter.db
#   sqlite:////absolute/path/converter.db     -> /absolute/path/converter.db
DATABASE_URL=sqlite:///data/document_converter.db

# Directory for uploaded and converted files. Relative paths use the project root.
STORAGE_DIR=data/storage

# Maximum accepted upload size, in bytes (default 20 MiB).
MAX_UPLOAD_BYTES=20971520

# Maximum accepted converter output size, in bytes (default 50 MiB).
MAX_OUTPUT_BYTES=52428800

# Bind address for `python run.py`.
HOST=127.0.0.1
PORT=5000

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
